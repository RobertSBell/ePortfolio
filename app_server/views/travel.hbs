<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
    <meta charset="UTF-8">
    <title>Travel - Travlr Getaways Website Template</title>
    <link rel="stylesheet" href="css/style.css" type="text/css">
</head>

<body>

<div id="background">

    <div id="page">

        {{> header }}

        <div id="contents">

            <div class="box">

                <div>

                    <div class="body">

                        <h1>Travel</h1>

                        <ul id="sites">

                            {{#each trips}}

                            <li>

                                <a href="/travel">
                                    <img
										src="/images/{{this.image}}"
										alt="Img"
										onerror="this.onerror=null; this.src='/images/default-trip.jpg';">
                                </a>

								<div class="trip-heading">

									<h2>
										<a href="/travel">{{this.name}}</a>
									</h2>

									<div class="trip-resort">

										<span class="resort-name">
											<strong>{{this.resort}}</strong>
										</span>

										{{#if this.starRating}}
											<span class="rating">
												{{this.starRating}}/5 ⭐
											</span>
										{{/if}}

									</div>

								</div>

								<p>
									<strong>Trip Length:</strong>
									{{this.length}} days / {{this.nights}} nights

									<br>

									<span class="trip-dates">
										<strong>Start Date:</strong>
										{{this.startDate}}
										<br>

										<strong>Return Date:</strong>
										{{this.endDate}}
									</span>

									<br>

                                    <strong>Price:</strong>
                                    ${{this.price}} per person

									<br>
									<span class="trip-description">
										{{this.description}}
									</span>
                                </p>

                            </li>

                            {{/each}}

                        </ul>

                    </div>

                </div>

            </div>

        </div>

    </div>

    {{> footer }}

</div>

</body>
</html>